{
  "name": "nexus-arcade",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test:compile": "tsc -p tsconfig.test.json",
    "test": "npm run build && npm run test:compile && node --test dist-test/tests/*.test.js",
    "start": "node dist/server.js",
    "start:bg": "node dist/server.js --daemon",
    "stop": "node dist/server.js --stop"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
